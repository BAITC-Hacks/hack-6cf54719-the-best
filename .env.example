# ==========================================
# Настройки LLM провайдеров
# ==========================================
# Выдается организаторами HackAlem AI (промокод на $100)
OPENAI_API_KEY=your_openai_api_key_here

# Опционально: резервные провайдеры для Fallback-сценариев
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# Конфигурация бэкенда (FastAPI)
# ==========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=production
LOG_LEVEL=info

# ==========================================
# Конфигурация фронтенда (Streamlit)
# ==========================================
# URL для обращения фронтенда к бэкенду внутри сети Docker
BACKEND_URL=http://backend:8000
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
POSTGRES_PASSWORD=replace_with_random_letters_and_numbers
# For running Python outside Docker:
# DATABASE_URL=postgresql+psycopg://ai_sana:YOUR_PASSWORD@localhost:5432/ai_sana
