# Local development values. Change the secrets before exposing the app publicly.
POSTGRES_DB=ai_sana
POSTGRES_USER=ai_sana
POSTGRES_PASSWORD=aisana_dev_password
JWT_SECRET_KEY=replace_with_a_long_random_secret_before_deploying

# Optional. Leave empty to keep the rest of the platform working without AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Local reviewer account for the imported Astana Hub snapshots. Local demo only.
ASTANAHUB_REVIEW_EMAIL=catalog@aisana.example.com
ASTANAHUB_REVIEW_PASSWORD=local-demo-change-me

# Host port for the web interface (use 8501 if it is free).
FRONTEND_PORT=8502
